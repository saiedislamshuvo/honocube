{
  "name": "@honocube/api",
  "version": "2.0.0",
  "description": "A lightweight, type-safe resource framework built on top of Hono and Drizzle ORM.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiedislamshuvo/honocube.git",
    "directory": "packages/api"
  },
  "homepage": "https://honocube.com",
  "bugs": {
    "url": "https://github.com/saiedislamshuvo/honocube/issues"
  },
  "keywords": [
    "hono",
    "drizzle",
    "drizzle-orm",
    "rest",
    "api",
    "framework",
    "typescript",
    "zod",
    "orm",
    "edge",
    "crud"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0",
    "hono": ">=4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@repo/eslint-config": "*",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.1",
    "hono": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.0.0"
  }
}
