{
  "name": "honocube",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "6.0.3",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
